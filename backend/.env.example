# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/fathom

# Auth
JWT_SECRET=replace-with-a-long-random-string

# ImageKit (post image uploads)
IMAGEKIT_PRIVATE_KEY=

# Frontend origin — used for CORS allowlisting and OAuth redirect targets.
# frontend/ (the Vite dev server) defaults to port 5173.
CLIENT_URL=http://localhost:5173

# Google OAuth 2.0
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
